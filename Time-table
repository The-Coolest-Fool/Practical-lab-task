<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Student Time Table</title>
</head>
<body>

    <h1 align="center">Student Time Table</h1>

    <table border="1" cellspacing="0" cellpadding="15" align="center" width="80%">
        <tr align="center">
            <th>Time</th>
            <th>Monday</th>
            <th>Tuesday</th>
            <th>Wednesday</th>
            <th>Thursday</th>
            <th>Friday</th>
        </tr>
        <tr align="center">
            <th>8:00 &ndash; 9:00</th>
            <td>English</td>
            <td>Mathematics</td>
            <td>Science</td>
            <td>English</td>
            <td>Mathematics</td>
        </tr>
        <tr align="center">
            <th>9:00 &ndash; 10:00</th>
            <td>Mathematics</td>
            <td>Science</td>
            <td>Social Studies</td>
            <td>Mathematics</td>
            <td>Science</td>
        </tr>
        <tr align="center">
            <th>10:00 &ndash; 11:00</th>
            <td>Science</td>
            <td>English</td>
            <td>Mathematics</td>
            <td>Social Studies</td>
            <td>English</td>
        </tr>
        <tr align="center">
            <th>11:00 &ndash; 12:00</th>
            <td>Social Studies</td>
            <td>Computer</td>
            <td>English</td>
            <td>Science</td>
            <td>Social Studies</td>
        </tr>
        <tr align="center">
            <th>12:00 &ndash; 1:00</th>
            <th colspan="5">Lunch Break</th>
        </tr>
        <tr align="center">
            <th>1:00 &ndash; 2:00</th>
            <td>Computer</td>
            <td>Social Studies</td>
            <td>Computer</td>
            <td>Mathematics</td>
            <td>Computer</td>
        </tr>
        <tr align="center">
            <th>2:00 &ndash; 3:00</th>
            <td rowspan="2">Physical<br>Education</td>
            <td>Art</td>
            <td rowspan="2">Physical<br>Education</td>
            <td>Art</td>
            <td rowspan="2">Physical<br>Education</td>
        </tr>
        <tr align="center">
            <th>3:00 &ndash; 4:00</th>
            <td>Moral Science</td>
            <td>Moral Science</td>
        </tr>
    </table>

</body>
</html>
