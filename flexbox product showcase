<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flexbox Product Showcase</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #f8faff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 40px 20px;
        }

        .showcase-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 24px;
            max-width: 1150px;
            width: 100%;
        }

        .product-card {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 16px;
            flex: 1 1 320px;
            max-width: 360px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
        }

        .product-image {
            background-color: #f4f5f7;
            border-radius: 6px;
            height: 230px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 18px;
            overflow: hidden;
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .product-title {
            font-size: 1.35rem;
            font-weight: 700;
            color: #111827;
            margin-bottom: 10px;
        }

        .product-description {
            font-size: 0.95rem;
            line-height: 1.5;
            color: #5b6777;
            margin-bottom: 18px;
            flex-grow: 1;
        }

        .product-price {
            font-size: 1.25rem;
            font-weight: 700;
            color: #1d4ed8;
            margin-bottom: 14px;
        }

        .buy-btn {
            background-color: #2563eb;
            color: #ffffff;
            border: none;
            border-radius: 6px;
            padding: 13px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            width: 100%;
            transition: background-color 0.2s ease;
        }

        .buy-btn:hover {
            background-color: #1d4ed8;
        }
    </style>
</head>
<body>

    <div class="showcase-container">
        <!-- Card 1: Laptop -->
        <div class="product-card">
            <div class="product-image">
                <img src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=600&q=80" alt="Laptop">
            </div>
            <h2 class="product-title">Laptop</h2>
            <p class="product-description">
                Powerful performance for work and gaming. Sleek design with a stunning display.
            </p>
            <div class="product-price">&#8377;59,999</div>
            <button class="buy-btn">Buy Now</button>
        </div>

        <!-- Card 2: Headphones -->
        <div class="product-card">
            <div class="product-image">
                <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=600&q=80" alt="Headphones">
            </div>
            <h2 class="product-title">Headphones</h2>
            <p class="product-description">
                High-quality sound with noise cancellation. Perfect for music and calls.
            </p>
            <div class="product-price">&#8377;4,999</div>
            <button class="buy-btn">Buy Now</button>
        </div>

        <!-- Card 3: Smartwatch -->
        <div class="product-card">
            <div class="product-image">
                <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=600&q=80" alt="Smartwatch">
            </div>
            <h2 class="product-title">Smartwatch</h2>
            <p class="product-description">
                Track your fitness, heart rate and stay connected on the go.
            </p>
            <div class="product-price">&#8377;7,999</div>
            <button class="buy-btn">Buy Now</button>
        </div>
    </div>

</body>
</html>
